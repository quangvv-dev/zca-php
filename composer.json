{
    "name": "eric-sa/zca-php",
    "description": "Unofficial Zalo API for PHP (port of zca-js)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "zalo",
        "api",
        "chatbot",
        "laravel"
    ],
    "homepage": "https://github.com/quangvv-dev/zca-php",
    "support": {
        "issues": "https://github.com/quangvv-dev/zca-php/issues",
        "source": "https://github.com/quangvv-dev/zca-php"
    },
    "require": {
        "php": "^7.1.3 || ^8.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "guzzlehttp/guzzle": "^6.5.8 || ^7.0",
        "evenement/evenement": "^3.0",
        "ratchet/pawl": "^0.3 || ^0.4",
        "react/event-loop": "^1.2",
        "react/promise": "^2.8 || ^3.0",
        "react/promise-timer": "^1.9",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/polyfill-php80": "^1.17",
        "symfony/polyfill-php81": "^1.20",
        "symfony/polyfill-mbstring": "^1.17"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel service provider and facade"
    },
    "autoload": {
        "psr-4": {
            "Zca\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Zca\\Laravel\\ZcaServiceProvider"
            ],
            "aliases": {
                "Zalo": "Zca\\Laravel\\Facades\\Zalo"
            }
        }
    },
    "config": {
        "platform": {
            "php": "7.1.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
