{
    "name": "eric-sa/zca-php",
    "description": "Unofficial Zalo API for PHP (port of zca-js)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "zalo",
        "api",
        "chatbot",
        "laravel"
    ],
    "homepage": "https://github.com/quangvv-dev/zca-php",
    "support": {
        "issues": "https://github.com/quangvv-dev/zca-php/issues",
        "source": "https://github.com/quangvv-dev/zca-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "guzzlehttp/guzzle": "^7.8",
        "evenement/evenement": "^3.0",
        "ratchet/pawl": "^0.4.1",
        "react/async": "^4.3",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "react/promise-timer": "^1.11",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel service provider and facade"
    },
    "autoload": {
        "psr-4": {
            "Zca\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Zca\\Laravel\\ZcaServiceProvider"
            ],
            "aliases": {
                "Zalo": "Zca\\Laravel\\Facades\\Zalo"
            }
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
